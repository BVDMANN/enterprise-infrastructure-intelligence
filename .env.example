# .env.example — Enterprise Infrastructure Intelligence
# Copier vers .env puis renseigner. NE JAMAIS commiter un .env réel.
# Les valeurs ci-dessous sont des PLACEHOLDERS de développement uniquement.
# En staging/production, les secrets viennent d'un gestionnaire dédié
# (ex. HashiCorp Vault) — jamais en clair dans le code ou dans Git.

# --- Base de données ---
POSTGRES_DB=eii
POSTGRES_USER=eii
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgresql+psycopg://eii:change_me_dev_only@db:5432/eii

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- API ---
SECRET_KEY=change_me_dev_only
API_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Authentification (OIDC) — à renseigner en PHASE 1 ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Connecteur de simulation ---
SIMULATED=true
