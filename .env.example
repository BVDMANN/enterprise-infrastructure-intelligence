# .env.example — Enterprise Infrastructure Intelligence
# Copier vers .env puis renseigner. NE JAMAIS commiter un .env réel.
# Les valeurs ci-dessous sont des PLACEHOLDERS de développement uniquement.
# En staging/production, utiliser un gestionnaire de secrets dédié.

# --- PostgreSQL bootstrap administrator (database container/bootstrap only) ---
POSTGRES_DB=eii
POSTGRES_USER=eii
POSTGRES_PASSWORD=change_me_dev_only

# --- Application roles (development placeholders only) ---
POSTGRES_RUNTIME_USER=eii_runtime
POSTGRES_RUNTIME_PASSWORD=change_me_runtime_dev_only
POSTGRES_MIGRATOR_USER=eii_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me_migrator_dev_only

# Existing-volume ownership transfer is opt-in and changes object ownership.
# Keep false unless the volume was inspected and a recoverable backup exists.
EII_ADOPT_EXISTING_SCHEMA_OWNERSHIP=false

# Compose builds DATABASE_URL for API/Worker from the runtime values above.
# MIGRATION_DATABASE_URL is supplied only to the one-shot "migrate" service.
# When running API/Alembic directly outside Compose, set those two URLs
# explicitly to the runtime and migrator accounts respectively.

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- API ---
SECRET_KEY=change_me_dev_only
API_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Authentification (OIDC) — à renseigner en PHASE 1 ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Connecteur de simulation ---
SIMULATED=true
